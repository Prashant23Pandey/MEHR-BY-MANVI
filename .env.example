# Hosted libSQL/Turso. When set, DATABASE_PATH is ignored.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local SQLite file path. Use an absolute path on a persistent volume.
DATABASE_PATH=

# Random secret used to hash visitor IPs for rate limiting. Set in production.
IP_HASH_SALT=

# Cloudflare Turnstile. Set both keys to enable, or leave both blank to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional POST endpoint for new application notifications.
APPLICATION_WEBHOOK_URL=
